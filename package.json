{
  "name": "@groupe-savoy/teltonika-sdk",
  "version": "0.3.1",
  "description": "A TypeScript SDK for interacting with Teltonika devices.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Groupe-Savoy/teltonika-sdk#readme",
  "bugs": {
    "url": "https://github.com/Groupe-Savoy/teltonika-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Groupe-Savoy/teltonika-sdk.git"
  },
  "author": "Emilien Leroy <eleroy@savoy-international.com>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --format esm --format cjs",
    "dev": "tsx watch",
    "dev:parser:codec8": "cross-env DEBUG=teltonika-sdk:* tsx watch ./examples/parser/codec8.ts",
    "dev:parser:codec8e": "cross-env DEBUG=teltonika-sdk:* tsx watch ./examples/parser/codec8e.ts",
    "dev:parser:codec12": "cross-env DEBUG=teltonika-sdk:* tsx watch ./examples/parser/codec12.ts",
    "dev:parser:codec14": "cross-env DEBUG=teltonika-sdk:* tsx watch ./examples/parser/codec14.ts",
    "dev:parser:codec16": "cross-env DEBUG=teltonika-sdk:* tsx watch ./examples/parser/codec16.ts",
    "dev:server:codec8e:tcp": "cross-env DEBUG=teltonika-sdk:* tsx watch ./examples/server/codec8e.tcp.ts",
    "dev:server:codec8e:tls": "cross-env NODE_DEBUG=tls DEBUG=teltonika-sdk:* tsx watch ./examples/server/codec8e.tls.ts",
    "dev:server:codec12:tcp": "cross-env DEBUG=teltonika-sdk:* tsx watch ./examples/server/codec12.tcp.ts",
    "dev:server:codec12:tls": "cross-env NODE_DEBUG=tls DEBUG=teltonika-sdk:* tsx watch ./examples/server/codec12.tls.ts",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "docs": "typedoc --categorizeByGroup",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "release": "node ./scripts/version"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "4.1.2",
    "bumpp": "^10.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "tsdown": "^0.16.8",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "uuid": "11.1.0"
  }
}
